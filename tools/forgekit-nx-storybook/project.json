{
  "name": "effinrich-nx-storybook",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "tools/effinrich-nx-storybook/src",
  "projectType": "library",
  "tags": ["scope:shared", "type:plugin"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/tools/effinrich-nx-storybook",
        "main": "tools/effinrich-nx-storybook/src/index.ts",
        "tsConfig": "tools/effinrich-nx-storybook/tsconfig.lib.json",
        "assets": [
          "tools/effinrich-nx-storybook/*.md",
          {
            "input": "tools/effinrich-nx-storybook",
            "glob": "**/*.json",
            "output": "."
          },
          {
            "input": "tools/effinrich-nx-storybook/src",
            "glob": "**/*.json",
            "output": "./src"
          }
        ]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "options": {
        "jestConfig": "tools/effinrich-nx-storybook/jest.config.ts",
        "passWithNoTests": true
      }
    }
  }
}
